# ═══════════════════════════════════════════════════════════════
# Configuration d'Environnement - Bibliothèque App
# ═══════════════════════════════════════════════════════════════
#
# Copiez ce fichier vers .env.local et remplissez les valeurs
# cp .env.example .env.local
#
# IMPORTANT : Ne committez JAMAIS le fichier .env.local dans Git !
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
# Configuration Node.js
# ───────────────────────────────────────────────────────────────

# Environnement d'exécution
# Valeurs possibles : development | production | test
NODE_ENV=development

# ───────────────────────────────────────────────────────────────
# Configuration Next.js
# ───────────────────────────────────────────────────────────────

# URL publique de l'application
# En développement : http://localhost:3000
# En production : https://votre-domaine.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Port du serveur (optionnel, défaut : 3000)
# PORT=3000

# ───────────────────────────────────────────────────────────────
# APIs Externes
# ───────────────────────────────────────────────────────────────

# Google Books API (optionnel)
# L'application fonctionne sans clé API mais avec des limitations
# Pour obtenir une clé : https://console.cloud.google.com/
# GOOGLE_BOOKS_API_KEY=votre_cle_google_books_api_ici

# Open Library API (alternative à Google Books - pas encore implémentée)
# OPEN_LIBRARY_API_URL=https://openlibrary.org/api

# ───────────────────────────────────────────────────────────────
# Sécurité et Sessions
# ───────────────────────────────────────────────────────────────

# Secret pour les sessions (OBLIGATOIRE en production)
# Générez une clé aléatoire de 32+ caractères
# Vous pouvez utiliser : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=generer_une_cle_aleatoire_de_32_caracteres_minimum

# Durée de validité des sessions en secondes (défaut : 86400 = 24h)
# SESSION_MAX_AGE=86400

# Activer les cookies sécurisés (HTTPS uniquement)
# En production, mettez à true
# SECURE_COOKIES=false

# ───────────────────────────────────────────────────────────────
# Base de Données (pour une implémentation future)
# ───────────────────────────────────────────────────────────────

# PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/bibliotheque

# MongoDB
# MONGODB_URI=mongodb://localhost:27017/bibliotheque

# Redis (pour les sessions en production)
# REDIS_URL=redis://localhost:6379

# ───────────────────────────────────────────────────────────────
# Services de Stockage (pour une implémentation future)
# ───────────────────────────────────────────────────────────────

# AWS S3 (pour stocker les couvertures de livres)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=votre_access_key
# AWS_SECRET_ACCESS_KEY=votre_secret_key
# AWS_S3_BUCKET=bibliotheque-covers

# Cloudinary (alternative pour les images)
# CLOUDINARY_CLOUD_NAME=votre_cloud_name
# CLOUDINARY_API_KEY=votre_api_key
# CLOUDINARY_API_SECRET=votre_api_secret

# ───────────────────────────────────────────────────────────────
# OCR et Traitement d'Images
# ───────────────────────────────────────────────────────────────

# Tesseract.js (OCR local - déjà intégré, pas besoin de config)
# TESSERACT_LANG=fra+eng

# Google Cloud Vision API (OCR cloud - alternative)
# GOOGLE_VISION_API_KEY=votre_cle_vision_api

# ───────────────────────────────────────────────────────────────
# Email (pour une implémentation future)
# ───────────────────────────────────────────────────────────────

# SMTP pour l'envoi d'emails
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=votre_email@gmail.com
# SMTP_PASSWORD=votre_mot_de_passe_application
# SMTP_FROM=noreply@bibliotheque.fr

# SendGrid (alternative)
# SENDGRID_API_KEY=votre_cle_sendgrid

# ───────────────────────────────────────────────────────────────
# Analytics et Monitoring
# ───────────────────────────────────────────────────────────────

# Vercel Analytics (déjà intégré)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=votre_id

# Google Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry (monitoring d'erreurs)
# SENTRY_DSN=votre_dsn_sentry
# NEXT_PUBLIC_SENTRY_DSN=votre_dsn_sentry

# ───────────────────────────────────────────────────────────────
# Développement et Debug
# ───────────────────────────────────────────────────────────────

# Activer les logs détaillés
# DEBUG=true

# Niveau de log (error | warn | info | debug)
# LOG_LEVEL=info

# ───────────────────────────────────────────────────────────────
# Rate Limiting (pour une implémentation future)
# ───────────────────────────────────────────────────────────────

# Nombre maximum de requêtes par IP par minute
# RATE_LIMIT_MAX_REQUESTS=100

# Fenêtre de temps en secondes
# RATE_LIMIT_WINDOW=60

# ═══════════════════════════════════════════════════════════════
# Notes de Configuration
# ═══════════════════════════════════════════════════════════════
#
# 1. Variables NEXT_PUBLIC_* sont exposées côté client
#    Ne mettez JAMAIS de secrets dans ces variables !
#
# 2. Générez des secrets forts pour la production :
#    - SESSION_SECRET : minimum 32 caractères aléatoires
#    - Clés API : utilisez des clés dédiées par environnement
#
# 3. Pour la production :
#    - Utilisez une vraie base de données (PostgreSQL/MongoDB)
#    - Activez HTTPS (SECURE_COOKIES=true)
#    - Configurez le monitoring et les logs
#    - Implémentez le rate limiting
#
# 4. Ne commitez JAMAIS .env.local dans Git
#    Vérifiez que .env.local est dans .gitignore
#
# ═══════════════════════════════════════════════════════════════
